<Project>

  <!-- Configurações comuns a todos os projetos da solução -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Sem "implicit usings": cada arquivo declara seus próprios using (evita ambiguidades, ex.: Timer no WinForms). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Permite compilar/testar (ex.: CI em Linux) projetos net8.0-windows; a execução continua exigindo Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <Company>Florest Sistemas</Company>
    <Product>Florest Print Agent</Product>
    <Copyright>Florest Sistemas</Copyright>
  </PropertyGroup>

</Project>
