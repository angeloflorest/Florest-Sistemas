<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FlorestPrintAgent.Core</RootNamespace>
    <AssemblyName>FlorestPrintAgent.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.21" />
    <!-- Pacotes oficiais Microsoft (únicas dependências externas do Core) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Jobs\Fonts\Montserrat-Regular.ttf" />
    <EmbeddedResource Include="Jobs\Fonts\Montserrat-Bold.ttf" />
    <None Update="Jobs\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlorestPrintAgent.Tests" />
  </ItemGroup>

</Project>
